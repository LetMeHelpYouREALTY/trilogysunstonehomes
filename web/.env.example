# Google Search Console — HTML tag verification (content value only, not the full meta tag)
# Set in Vercel → Project → Environment Variables for Production, then redeploy.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Maps Platform — Maps JavaScript API + Places (for /amenities interactive map)
# Set in Vercel → Environment Variables for Production/Preview, then redeploy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for Advanced Markers / styled vector maps
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Calendly — private 15-min conversation (default matches Calendly dashboard embed)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/drjanduffy/dr-duffy-private-15-min-conversation

# Optional: v0 Platform API (design tooling only)
# V0_API_KEY=
# V0_DESIGN_API_SECRET=
